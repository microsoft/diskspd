<?xml version="1.0" encoding="utf-8"?>
<!--
    Imported BEFORE Microsoft.Cpp.props by DiskSpd static library .vcxproj
    files.  Microsoft.Cpp.props reads ConfigurationType to decide which
    Microsoft.Cpp.*.props (StaticLibrary, Application, etc.) to chain in.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Configuration-level defaults shared by DiskSpd static library projects. -->
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
</Project>
