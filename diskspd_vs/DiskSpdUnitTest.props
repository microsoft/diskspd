<?xml version="1.0" encoding="utf-8"?>
<!--
    Imported AFTER Microsoft.Cpp.props by DiskSpd TAEF unit-test .vcxproj
    files.  ClCompile/Link items, $(IncludePath), and $(LibraryPath) all
    require the toolset chain to be loaded first.

    Imported after the per-user Microsoft.Cpp.$(Platform).user.props so the
    project-mandated TAEF includes/libs override any user customization.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetName>$(ProjectName).UnitTests</TargetName>
    <IncludePath>$(MSBuildThisFileDirectory)..\UnitTests\Shared;$(WindowsSDKDir)\Testing\Development\inc;$(IncludePath)</IncludePath>
    <LibraryPath>$(WindowsSDKDir)\Testing\Development\lib\$(PlatformTarget);$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <!--
      Tell VS Test Explorer which runsettings file to use for each platform, so
      the TAEF adapter (TestAdaptersPaths in the runsettings) is discovered
      automatically without requiring each user to pick it via
      Test > Configure Run Settings > Select Solution Wide Runsettings File.
  -->
  <PropertyGroup>
    <RunSettingsFilePath Condition="'$(Platform)'=='Win32'">$(MSBuildThisFileDirectory)diskspd.win32.runsettings</RunSettingsFilePath>
    <RunSettingsFilePath Condition="'$(Platform)'=='x64'">$(MSBuildThisFileDirectory)diskspd.x64.runsettings</RunSettingsFilePath>
    <RunSettingsFilePath Condition="'$(Platform)'=='ARM64'">$(MSBuildThisFileDirectory)diskspd.arm64.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <ConformanceMode>false</ConformanceMode>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>Common.lib;powrprof.lib;onecore.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(OutDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
