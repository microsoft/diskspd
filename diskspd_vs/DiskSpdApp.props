<?xml version="1.0" encoding="utf-8"?>
<!--
    Imported BEFORE Microsoft.Cpp.props by DiskSpd executable .vcxproj files.
    Microsoft.Cpp.props reads ConfigurationType to decide which
    Microsoft.Cpp.*.props (StaticLibrary, Application, etc.) to chain in.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Configuration-level defaults shared by DiskSpd executable (Application) projects. -->
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
</Project>
